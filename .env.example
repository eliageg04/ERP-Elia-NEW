# SQLite-Datenbank (lokale Entwicklung). Auf Vercel wird DATABASE_URL von der
# Neon-Postgres-Integration gesetzt – der Build stellt automatisch um.
DATABASE_URL="file:./erp.db"

# Secret für Session-Cookies (min. 32 Zeichen, zufällig generieren!)
SESSION_SECRET="change-me-to-a-long-random-string-0000"
